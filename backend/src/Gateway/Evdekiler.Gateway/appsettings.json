{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "pantry-route": {
        "ClusterId": "pantry",
        "Match": { "Path": "/api/pantry/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-1": { "Address": "http://localhost:5208" }
        }
      },
      "pantry": {
        "Destinations": {
          "pantry-1": { "Address": "http://localhost:5210" }
        }
      }
    }
  }
}