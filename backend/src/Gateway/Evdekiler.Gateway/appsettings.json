{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "pantry-route": {
        "ClusterId": "pantry",
        "Match": { "Path": "/api/pantry/{**catch-all}" }
      },
      "admin-ingredients-route": {
        "ClusterId": "pantry",
        "Match": { "Path": "/api/admin/ingredients/{**catch-all}" }
      },
      "ingredient-images-route": {
        "ClusterId": "pantry",
        "Match": { "Path": "/images/ingredients/{**catch-all}" }
      },
      "recipes-route": {
        "ClusterId": "recipe",
        "Match": { "Path": "/api/recipes/{**catch-all}" }
      },
      "admin-recipes-route": {
        "ClusterId": "recipe",
        "Match": { "Path": "/api/admin/recipes/{**catch-all}" }
      },
      "recipe-images-route": {
        "ClusterId": "recipe",
        "Match": { "Path": "/images/recipes/{**catch-all}" }
      },
      "media-route": {
        "ClusterId": "storage",
        "Match": { "Path": "/media/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/devstoreaccount1/media/{**catch-all}" }
        ]
      },
      "shopping-route": {
        "ClusterId": "shopping",
        "Match": { "Path": "/api/shopping/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity1": { "Address": "http://localhost:5208" }
        }
      },
      "pantry": {
        "Destinations": {
          "pantry1": { "Address": "http://localhost:5210" }
        }
      },
      "recipe": {
        "Destinations": {
          "recipe1": { "Address": "http://localhost:5212" }
        }
      },
      "shopping": {
        "Destinations": {
          "shopping1": { "Address": "http://localhost:5214" }
        }
      },
      "storage": {
        "Destinations": {
          "storage1": { "Address": "http://localhost:10000" }
        }
      }
    }
  }
}